# Provider API keys (hosted mode). Leave empty to run BYO-key only.
GEMINI_API_KEY=
OPENAI_API_KEY=
REPLICATE_API_TOKEN=

# Provider used when the client does not pick one.
DEFAULT_PROVIDER=gemini

# Free renders per anonymous visitor (hosted mode).
FREE_CREDITS=3

# Self-host file project storage. Leave empty to use apps/web/.reno-data in dev.
RENO_DATA_DIR=
RENO_MAX_PROJECTS_PER_VISITOR=100
RENO_MAX_RENDERS_PER_PROJECT=80

NEXT_PUBLIC_APP_URL=http://localhost:3000
