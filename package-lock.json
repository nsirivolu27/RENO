{
  "name": "reno",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "reno",
      "version": "0.1.0",
      "license": "MIT",
      "workspaces": [
        "packages/core",
        "apps/web",
        "apps/mobile"
      ]
    },
    "apps/mobile": {
      "name": "@reno/mobile",
      "version": "0.1.0",
      "license": "MIT",
      "dependencies": {
        "expo": "~52.0.0",
        "expo-image-picker": "~16.0.3",
        "expo-status-bar": "~2.0.0",
        "react": "18.3.1",
        "react-native": "0.76.5"
      },
      "devDependencies": {
        "@types/react": "~18.3.12",
        "typescript": "~5.3.3"
      }
    },
    "apps/web": {
      "name": "@reno/web",
      "version": "0.1.0",
      "license": "MIT",
      "dependencies": {
        "@reno/core": "*",
        "next": "^15.1.6",
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
      },
      "devDependencies": {
        "@types/node": "^22.10.5",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "typescript": "^5.7.2"
      }
    },
    "node_modules/@reno/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/@reno/mobile": {
      "resolved": "apps/mobile",
      "link": true
    },
    "node_modules/@reno/web": {
      "resolved": "apps/web",
      "link": true
    },
    "packages/core": {
      "name": "@reno/core",
      "version": "0.1.0",
      "license": "MIT",
      "devDependencies": {
        "typescript": "^5.7.2"
      }
    }
  }
}
